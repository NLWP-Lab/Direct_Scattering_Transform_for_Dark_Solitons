Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Title", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Numerical", " ", "DST", " ", "for", " ", "the", " ", "Single"}], 
    "-", 
    RowBox[{"Soliton", " ", "Potential"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "SolitonDST", " ", "library", " ", "must", " ", "be", " ", 
    "loaded", " ", "before", " ", "this", " ", 
    RowBox[{"block", "."}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Simulation", " ", "Parameters"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "precision", ",", "domainWidth", ",", "backgroundAmplitude", ",", 
      "discretizationDegree", ",", "numPoints", ",", "stepSize", ",", 
      "integrationSteps", ",", "solitonEigenvalue", ",", "solitonPosition", 
      ",", "time", ",", "nu", ",", "x", ",", "z", ",", "oneSolitonPotential", 
      ",", "normingConstantRho", ",", "spatialGrid", ",", "potentialData", 
      ",", "phaseMinus", ",", "phasePlus", ",", "potentialPlot", ",", 
      "singleSolitonA", ",", "singleSolitonRealA", ",", "numericalEigenvalue",
       ",", "numericalRho", ",", "solitonResult", ",", "zetaPlotMin", ",", 
      "zetaPlotMax", ",", "numSpectralPoints", ",", "zetaPlotGrid", ",", 
      "spectralPlotValues", ",", "spectralRealData", ",", 
      "spectralImaginaryData", ",", "spectralCoefficientPlot"}], "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precision", "=", "100"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"domainWidth", "=", 
     RowBox[{"N", "[", 
      RowBox[{"50", ",", "precision"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"backgroundAmplitude", "=", 
     RowBox[{"N", "[", 
      RowBox[{"1.9", ",", "precision"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"discretizationDegree", "=", "11"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPoints", "=", 
     RowBox[{"2", "^", "discretizationDegree"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stepSize", "=", 
     RowBox[{"domainWidth", "/", "numPoints"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"integrationSteps", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"stepSize", ",", "numPoints"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Soliton", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"solitonEigenvalue", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"-", "1.1"}], ",", "precision"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"solitonPosition", "=", 
     RowBox[{"N", "[", 
      RowBox[{"1.0", ",", "precision"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nu", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"backgroundAmplitude", "^", "2"}], "-", 
       RowBox[{"solitonEigenvalue", "^", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Single"}], "-", 
     RowBox[{"Soliton", " ", "Potential"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"oneSolitonPotential", ",", "normingConstantRho"}], "]"}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"oneSolitonPotential", "[", 
      RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "backgroundAmplitude"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"solitonEigenvalue", "-", 
        RowBox[{"I", " ", "nu"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"solitonEigenvalue", " ", "+", 
        RowBox[{"I", " ", "nu", " ", 
         RowBox[{"Tanh", "[", 
          RowBox[{"nu", " ", 
           RowBox[{"(", 
            RowBox[{"x", "-", "solitonPosition"}], ")"}]}], "]"}]}]}], 
       ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"normingConstantRho", "[", 
      RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "/", "backgroundAmplitude"}], " ", "I", " ", 
      RowBox[{"nu", "^", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "nu", " ", "solitonPosition"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Spatial", " ", "Grid"}], ",", "Potential", ",", 
     RowBox[{"and", " ", "Boundary", " ", "Phases"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"spatialGrid", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "domainWidth"}], "/", "2"}], "+", 
        RowBox[{"stepSize", " ", 
         RowBox[{"(", 
          RowBox[{"i", "-", 
           RowBox[{"1", "/", "2"}]}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "numPoints"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"potentialData", "=", 
     RowBox[{"oneSolitonPotential", "/@", "spatialGrid"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"phaseMinus", "=", 
     RowBox[{"Arg", "[", 
      RowBox[{"First", "[", "potentialData", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"phasePlus", "=", 
     RowBox[{"Arg", "[", 
      RowBox[{"Last", "[", "potentialData", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Potential", " ", "Visualization"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"potentialPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"spatialGrid", ",", 
            RowBox[{
             RowBox[{"Abs", "[", "potentialData", "]"}], "^", "2"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"spatialGrid", ",", 
            RowBox[{"Arg", "[", "potentialData", "]"}]}], "}"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<|\[Psi]|\.b2\>\"", ",", "\"\<Arg[\[Psi]]\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", 
            RowBox[{"Thickness", "[", "0.002", "]"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", 
            RowBox[{"Thickness", "[", "0.002", "]"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<One-Soliton Potential\>\"", ",", "14", ",", "Bold"}], 
         "]"}]}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "650"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "potentialPlot", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
